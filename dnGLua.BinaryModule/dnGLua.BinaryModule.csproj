    <!-- Rename the native-export file after a successful Build -->
    <Target Condition="'$(PublishAot)' != 'true'" Name="RenameNativeExportFile" AfterTargets="Build">
        <!-- Reminder: Garry's Mod Lua binary modules are always .dll regardless of platform -->
        <Move SourceFiles="$(TargetDir)$(AssemblyName)NE.dll"
              DestinationFiles="$(TargetDir)$(BinaryModuleFileName).dll"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(TargetDir)$(AssemblyName)NE.dll')"/>
    </Target>

    <!-- Delete the native-export file after project Clean -->
    <Target Condition="'$(PublishAot)' != 'true'" Name="CleanNativeExportFiles" AfterTargets="Clean">
        <!-- Reminder: Garry's Mod Lua binary modules are always .dll regardless of platform -->
        <ItemGroup>
            <!-- Define the files to remove within the target scope -->
            <FilesToDelete Include="$(TargetDir)$(BinaryModuleFileName).dll"/>
        </ItemGroup>
        <!-- The actual command that deletes the files -->
        <Delete Files="@(FilesToDelete)"/>
    </Target>

